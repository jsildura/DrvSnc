{
  "name": "google-drive-uploader",
  "version": "1.0.0",
  "description": "Chrome Extension to upload files to Google Drive from URLs or local files directly to Google Drive with Material 3 UI",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-app.js",
    "dev": "node scripts/start-app.js",
    "dev:web": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/web src/worker test --ext .ts,.tsx",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.10",
    "@mui/material": "^5.15.10",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.2",
    "jszip": "^3.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260818.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/chrome": "^0.0.260",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
